# Piper TTS Service Configuration

# ========== DEVELOPMENT (Localhost) ==========
# Path where Piper model files are stored
# For localhost development: Use your local Piper models directory
PIPER_MODELS_DIR=~/.local/share/piper

# For production/VPS: Use /opt/piper-models
# PIPER_MODELS_DIR=/opt/piper-models

# Directory to store generated audio files
PIPER_OUTPUT_DIR=/tmp/piper-audio-output

# Flask settings
FLASK_ENV=production
FLASK_DEBUG=false

