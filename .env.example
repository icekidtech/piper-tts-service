# Piper TTS Service Configuration

# Path to Piper model file (ONNX format)
# Download from: https://huggingface.co/rhasspy/piper-voices
# For local development, you can skip this if just testing the service endpoints
PIPER_MODEL_PATH=/opt/piper-models/en_US-male-medium.onnx

# Path to Piper model config file
PIPER_CONFIG_PATH=/opt/piper-models/en_US-male-medium.onnx.json

# Directory to store generated audio files
PIPER_OUTPUT_DIR=/tmp/piper-audio-output

# Flask settings
FLASK_ENV=production
FLASK_DEBUG=false

